# ── Printix → SFTP Connector – environment variable template ─────────────────
# Copy this file to .env, fill in the values, and keep it out of version control.
# NEVER commit .env to Git.

# ── Server ────────────────────────────────────────────────────────────────────
PORT=3000
LOG_STACK_TRACES=false

# ── Profile 1 – "invoices" ────────────────────────────────────────────────────

# Printix authentication (from Printix Administrator → Shared Secret Keys)
PROFILE_1_SECRET_KEYS=
PROFILE_1_TOKENS=

# SFTP connection
PROFILE_1_SFTP_HOST=sftp.yourserver.com
PROFILE_1_SFTP_PORT=22
PROFILE_1_SFTP_USER=printix

# Authentication – choose ONE of the following:

# Option A: password
PROFILE_1_SFTP_PASSWORD=

# Option B: private key (path inside the container, e.g. /run/secrets/sftp_key_p1)
# Uncomment the volumes block in docker-compose.yml to mount the key file.
PROFILE_1_SFTP_KEY_PATH=
PROFILE_1_SFTP_KEY_PASSPHRASE=

# Optional: expected SHA-256 host fingerprint (strongly recommended for production)
# Obtain with: ssh-keyscan -t ed25519 sftp.yourserver.com | ssh-keygen -lf -
PROFILE_1_SFTP_HOST_FINGERPRINT=

# Remote destination folder
# Supports tokens: {year} {month} {day} {profileId}
PROFILE_1_SFTP_REMOTE_DIR=/uploads/printix/invoices

# ── Profile 2 – "general" ─────────────────────────────────────────────────────

PROFILE_2_SECRET_KEYS=
PROFILE_2_TOKENS=

# Leave blank to fall back to Profile 1 SFTP settings
PROFILE_2_SFTP_HOST=
PROFILE_2_SFTP_PORT=22
PROFILE_2_SFTP_USER=

PROFILE_2_SFTP_PASSWORD=
PROFILE_2_SFTP_KEY_PATH=
PROFILE_2_SFTP_KEY_PASSPHRASE=
PROFILE_2_SFTP_HOST_FINGERPRINT=

PROFILE_2_SFTP_REMOTE_DIR=/uploads/printix/general/{year}/{month}/{day}
